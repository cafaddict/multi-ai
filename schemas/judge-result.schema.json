{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JudgeResult",
  "description": "Decision made by the Lead during its judge phase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "candidate",
    "snapshot",
    "rationale",
    "objective_evidence",
    "review_reports",
    "blocking_findings",
    "rejected_alternatives",
    "risks"
  ],
  "properties": {
    "decision": {"enum":["SELECT","INTEGRATE","REVISE","BLOCK","REJECT"]},
    "candidate": {"type":["string","null"],"minLength":1},
    "snapshot": {"anyOf":[{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},{"type":"null"}]},
    "rationale": {"type":"string","minLength":1},
    "objective_evidence": {"type":"array","items":{"$ref":"#/$defs/check"}},
    "review_reports": {"type":"array","items":{"type":"string","minLength":1}},
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding","resolution","evidence"],
        "properties": {
          "finding": {"type":"string","minLength":1},
          "resolution": {"enum":["fixed","rejected","unresolved"]},
          "evidence": {"type":"string","minLength":1}
        }
      }
    },
    "rejected_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate","reason"],
        "properties": {"candidate":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}
      }
    },
    "risks": {"type":"array","items":{"type":"string","minLength":1}}
  },
  "allOf": [
    {
      "if": {"properties":{"decision":{"enum":["SELECT","INTEGRATE"]}},"required":["decision"]},
      "then": {"properties":{"candidate":{"type":"string","minLength":1}}}
    },
    {
      "if": {"properties":{"decision":{"const":"INTEGRATE"}},"required":["decision"]},
      "then": {
        "properties": {
          "snapshot": {"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
          "objective_evidence": {"minItems":1},
          "review_reports": {"minItems":1},
          "blocking_findings": {"items":{"properties":{"resolution":{"enum":["fixed","rejected"]}}}}
        }
      }
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command","cwd","exit_code","result"],
      "properties": {
        "command": {"type":"string","minLength":1},
        "cwd": {"type":"string","minLength":1},
        "exit_code": {"type":["integer","null"]},
        "result": {"type":"string","minLength":1}
      }
    }
  }
}
