{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "worker_id",
    "role",
    "snapshot",
    "changes_summary",
    "verification",
    "risks",
    "unresolved_questions"
  ],
  "properties": {
    "status": {"enum":["ok","needs_revision","blocked"]},
    "summary": {"type":"string","minLength":1},
    "worker_id": {"type":"string","minLength":1},
    "role": {"enum":["architect","engineer","researcher"]},
    "snapshot": {"anyOf":[{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},{"type":"null"}]},
    "changes_summary": {"type":"string","minLength":1},
    "verification": {"type":"array","items":{"$ref":"#/$defs/check"}},
    "risks": {"type":"array","items":{"type":"string","minLength":1}},
    "unresolved_questions": {"type":"array","items":{"type":"string","minLength":1}}
  },
  "allOf": [
    {
      "if": {"properties":{"status":{"const":"ok"},"role":{"const":"engineer"}},"required":["status","role"]},
      "then": {"properties":{"snapshot":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}}}
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command","cwd","exit_code","result"],
      "properties": {
        "command": {"type":"string","minLength":1},
        "cwd": {"type":"string","minLength":1},
        "exit_code": {"type":["integer","null"]},
        "result": {"type":"string","minLength":1}
      }
    }
  }
}
