{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict","reviewer_id","maker_id","review_target","verification_performed","findings","residual_risk"],
  "properties": {
    "verdict": {"enum":["APPROVED","CHANGES_REQUESTED","BLOCKED"]},
    "reviewer_id": {"type":"string","minLength":1},
    "maker_id": {"type":"string","minLength":1},
    "review_target": {"anyOf":[{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},{"type":"null"}]},
    "verification_performed": {"type":"array","items":{"$ref":"#/$defs/check"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","blocking","claim","location","observation"],
        "properties": {
          "id": {"type":"string","minLength":1},
          "blocking": {"type":"boolean"},
          "claim": {"type":"string","minLength":1},
          "location": {"type":["string","null"]},
          "observation": {"type":"string","minLength":1}
        }
      }
    },
    "residual_risk": {"type":"array","items":{"type":"string","minLength":1}}
  },
  "allOf": [
    {
      "if": {"properties":{"verdict":{"const":"APPROVED"}},"required":["verdict"]},
      "then": {
        "properties": {
          "findings": {"not":{"contains":{"properties":{"blocking":{"const":true}},"required":["blocking"]}}},
          "verification_performed": {"minItems":1}
        }
      }
    },
    {
      "if": {"properties":{"verdict":{"const":"CHANGES_REQUESTED"}},"required":["verdict"]},
      "then": {
        "properties": {"findings":{"contains":{"properties":{"blocking":{"const":true}},"required":["blocking"]}}}
      }
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command","cwd","exit_code","result"],
      "properties": {
        "command": {"type":"string","minLength":1},
        "cwd": {"type":"string","minLength":1},
        "exit_code": {"type":["integer","null"]},
        "result": {"type":"string","minLength":1}
      }
    }
  }
}
